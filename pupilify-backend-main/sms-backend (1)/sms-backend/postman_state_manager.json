          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"priya.singh@state.com\",\n  \"password\": \"priya@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/manager-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "manager-login"]
        },
        "description": "Login as Priya Singh State Manager"
      },
      "response": []
    },
    {
      "name": "7. State Manager Login - Amit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"amit.patel@state.com\",\n  \"password\": \"amit@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/manager-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "manager-login"]
        },
        "description": "Login as Amit Patel State Manager"
      },
      "response": []
    },
    {
      "name": "8. Get All State Managers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/all",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "all"]
        },
        "description": "Get list of all State Managers"
      },
      "response": []
    },
    {
      "name": "9. Get State Manager by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "1"]
        },
        "description": "Get specific State Manager by ID (change 1 to desired ID)"
      },
      "response": []
    },
    {
      "name": "10. Update State Manager",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rajesh Kumar Updated\",\n  \"email\": \"rajesh.updated@state.com\",\n  \"password\": \"newpassword@123\",\n  \"active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/update/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "update", "1"]
        },
        "description": "Update State Manager details (change 1 to desired ID)"
      },
      "response": []
    },
    {
      "name": "11. Delete State Manager",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/delete/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "delete", "1"]
        },
        "description": "Delete State Manager (change 1 to desired ID)"
      },
      "response": []
    }
  ]
