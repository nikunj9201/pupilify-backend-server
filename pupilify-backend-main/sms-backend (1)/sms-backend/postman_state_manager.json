{
  "info": {
    "name": "State Manager - Create & Login",
    "description": "State Manager creation and login endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "superAdminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "stateManagerEmail",
      "value": "rajesh@state.com",
      "type": "string"
    },
    {
      "key": "stateManagerPassword",
      "value": "rajesh@123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Super Admin Login (GET TOKEN FIRST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin@school.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Get JWT token from Super Admin login.\nCopy the 'token' value from response and paste in superAdminToken variable."
      },
      "response": []
    },
    {
      "name": "2. Create State Manager (Rajesh Kumar)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rajesh Kumar\",\n  \"email\": \"rajesh@state.com\",\n  \"password\": \"rajesh@123\",\n  \"stateId\": 1,\n  \"role\": \"STATE_MANAGER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "create"]
        },
        "description": "Creates a new State Manager for State ID 1"
      },
      "response": []
    },
    {
      "name": "3. Create State Manager (Priya Singh)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Singh\",\n  \"email\": \"priya.singh@state.com\",\n  \"password\": \"priya@123\",\n  \"stateId\": 2,\n  \"role\": \"STATE_MANAGER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/superadmin/state-managers/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "superadmin", "state-managers", "create"]
        },
        "description": "Creates a new State Manager for State ID 2"
      },
      "response": []
    },
    {
      "name": "4. Create State Manager (Amit Patel)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amit Patel\",\n  \"email\": \"amit.patel@state.com\",\n  \"password\": \"amit@123\",\n  \"stateId\": 3,\n  \"role\": \"STATE_MANAGER\"\n}"
