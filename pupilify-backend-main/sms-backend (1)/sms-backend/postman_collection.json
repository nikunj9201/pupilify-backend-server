{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef0123456789",
    "name": "SmartSchool API - Quick Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection of key SmartSchool API endpoints (auth, state, district, principal, bus, student). Import into Postman and set {{baseUrl}} and {{token}} variables."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"superadmin@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "State - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Madhya Pradesh\",\n  \"code\": \"MP\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/superadmin/state/create", "host": ["{{baseUrl}}"], "path": ["api","superadmin","state","create"] }
      }
    },
    {
      "name": "State - List",
      "request": { "method": "GET", "header": [ { "key": "Authorization","value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/superadmin/state/all","host":["{{baseUrl}}"],"path":["api","superadmin","state","all"] } }
    },
    {
      "name": "District - Create",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Indore\",\n  \"code\": \"IND\",\n  \"state\": { \"id\": 1 }\n}" },
        "url": { "raw": "{{baseUrl}}/api/district/create", "host": ["{{baseUrl}}"], "path": ["api","district","create"] }
      }
    },
    {
      "name": "District - List (by state)",
      "request": { "method": "GET", "header": [ { "key": "Authorization","value":"Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/district/all?stateId=1","host":["{{baseUrl}}"],"path":["api","district","all"],"query":[{"key":"stateId","value":"1"}] } }
    },
    {
      "name": "Principal - Create",
      "request": {
        "method": "POST",
        "header": [ { "key":"Content-Type","value":"application/json" }, { "key":"Authorization","value":"Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"principal1@example.com\",\n  \"password\": \"Pass123!\",\n  \"school\": { \"id\": 5 },\n  \"role\": \"ROLE_ADMIN\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/admin/principals/create", "host": ["{{baseUrl}}"], "path": ["api","admin","principals","create"] }
      }
    },
    {
      "name": "Principal - List by School",
      "request": { "method": "GET", "header": [ { "key":"Authorization","value":"Bearer {{token}}" } ], "url": { "raw":"{{baseUrl}}/api/admin/principals/school/5","host":["{{baseUrl}}"],"path":["api","admin","principals","school","5"] } }
    },
    {
      "name": "Bus - Create",
      "request": {
        "method": "POST",
        "header": [ { "key":"Content-Type","value":"application/json" }, { "key":"Authorization","value":"Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"registrationNo\": \"MP09AB1234\",\n  \"routeName\": \"North Route\",\n  \"capacity\": 40,\n  \"school\": {\"id\": 5}\n}" },
        "url": { "raw": "{{baseUrl}}/api/admin/buses/create", "host": ["{{baseUrl}}"], "path": ["api","admin","buses","create"] }
      }
    },
    {
      "name": "Bus - List by School",
      "request": { "method": "GET", "header": [ { "key":"Authorization","value":"Bearer {{token}}" } ], "url": { "raw":"{{baseUrl}}/api/admin/buses/school/5","host":["{{baseUrl}}"],"path":["api","admin","buses","school","5"] } }
    },
    {
      "name": "Student - Onboard (multipart) - Template",
      "request": {
        "method": "POST",
        "header": [ { "key":"Authorization","value":"Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "-- Use Postman form-data: key 'studentData' (text) with JSON string. Files optional.\nExample studentData JSON:\n{ \"name\": \"Anita Sharma\", \"email\": \"anita.s@example.com\", \"password\": \"secret123\" }\n" },
        "url": { "raw": "{{baseUrl}}/api/admin/students/onboard/5/3/1?academicYearId=1","host":["{{baseUrl}}"],"path":["api","admin","students","onboard","5","3","1"],"query":[{"key":"academicYearId","value":"1"}] }
      }
    },
    {
      "name": "Student - Get By Id",
      "request": { "method": "GET", "header": [ { "key":"Authorization","value":"Bearer {{token}}" } ], "url": { "raw":"{{baseUrl}}/api/admin/students/42","host":["{{baseUrl}}"],"path":["api","admin","students","42"] } }
    }
  ]
}

